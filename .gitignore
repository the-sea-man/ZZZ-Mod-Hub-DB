# =======================================================
# Permanent Whitelist: Only Track Distribution Database Files
# =======================================================

# 1. Ignore everything by default
/*

# 2. Whitelist distribution JSON database files
!/*.json

# 3. Whitelist image assets
!/images/
!/images/**

# 4. Whitelist Git configuration
!/.gitignore

# 5. Exclude internal reports, temporary files, and scratch artifacts
/character_health_report.json
/merge_report.json
/test*.json
*.tmp
*.bak
*.log
__pycache__/
*.pyc
